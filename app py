# 2. COMPANY ENDPOINTS
# =========================================================

@app.route("/company", methods=["POST"])
def add_company():

    data = request.get_json()

    if not data:
        return jsonify({
            "error": "JSON data is required"
        }), 400

    name = data.get("name")
    location = data.get("location")

    if not name or not location:
        return jsonify({
            "error": "Company name and location are required"
        }), 400

    db = get_db()

    db.execute(
        """
        INSERT INTO companies (name, location)
        VALUES (?, ?)
        """,
        (name, location)
    )

    db.commit()

    return jsonify({
        "message": "Company added"
    }), 201


@app.route("/companies", methods=["GET"])
def get_companies():

    db = get_db()

    companies = db.execute(
        "SELECT * FROM companies"
    ).fetchall()

    return jsonify([
        dict(company)
        for company in companies
    ])


# =========================================================
# 3. JOB ENDPOINTS
# =========================================================

@app.route("/add_job", methods=["POST"])
def add_job():

    data = request.get_json()

    if not data:
        return jsonify({
            "error": "JSON data is required"
        }), 400

    title = data.get("title")
    company_id = data.get("company_id")
    location = data.get("location")
    salary = data.get("salary")
    job_type = data.get("job_type")

    if not title or not company_id:
        return jsonify({
            "error": "Title and company_id are required"
        }), 400

    db = get_db()

    # Check that company exists
    company = db.execute(
        """
        SELECT id FROM companies
        WHERE id = ?
        """,
        (company_id,)
    ).fetchone()

    if not company:
        return jsonify({
            "error": "Company not found"
        }), 404

    db.execute(
        """
        INSERT INTO jobs (
            title,
            company_id,
            location,
            salary,
            job_type
        )
        VALUES (?, ?, ?, ?, ?)
        """,
        (
            title,
            company_id,
            location,
            salary,
            job_type
        )
    )

    db.commit()

    return jsonify({
        "message": "Job added!"
    }), 201